    {
        "id": "79c323ee11f88a9e",
        "type": "function",
        "z": "4622c857b1629484",
        "name": "decode: site register profiles",
        "func": "// Site register profiles: the only place that knows what a PLC looks like.\nconst PROFILES = {\n    STD: {\n        state: { 0: 'STOPPED', 1: 'RUNNING', 2: 'IDLE', 3: 'FAULTED' },\n        tempC: r => r[1] / 10,\n        good: r => ((r[3] << 16) | r[4]) >>> 0,\n    },\n    LEGACY_F: {                                   // Plant 7, S7-300 retrofit\n        state: { 0: 'STOPPED', 10: 'RUNNING', 20: 'IDLE', 30: 'FAULTED' },\n        tempC: r => ((r[1] / 10) - 32) * 5 / 9,\n        good: r => ((r[4] << 16) | r[3]) >>> 0,   // low word first\n    },\n};\nconst SITES = {\n    P03: { name: 'Plant 3', city: 'Columbus, OH', nameplateBpm: 600 },\n    P07: { name: 'Plant 7', city: 'Fresno, CA', nameplateBpm: 450 },\n    P12: { name: 'Plant 12', city: 'Monterrey, MX', nameplateBpm: 720 },\n};\nconst FAULTS = { 0: '', 2104: 'Capper jam (star wheel)', 3310: 'Starved: low bottle supply' };\n\nconst p = msg.payload;\nconst prof = PROFILES[p.map];\nif (!prof || !SITES[p.site]) { node.warn('unknown site/profile ' + p.site + '/' + p.map); return null; }\nconst r = p.regs;\nconst tag = {\n    site: p.site, ...SITES[p.site], line: p.line, plc: p.plcModel, profile: p.map,\n    state: prof.state[r[0]] || 'UNKNOWN',\n    tempC: Math.round(prof.tempC(r) * 10) / 10,\n    speedBpm: r[2], goodTotal: prof.good(r), rejectTotal: r[5],\n    faultCode: r[6], faultText: FAULTS[r[6]] || ('Fault ' + r[6]), ts: p.ts,\n};\n\n// Keep a rolling 5-minute window of samples per line for the OEE standard.\nconst acc = global.get('edge_acc') || {};\nconst a = acc[p.site] || { samples: [], prevGood: tag.goodTotal, prevRej: tag.rejectTotal, prevTs: p.ts, state: tag.state, since: p.ts };\nconst dt = Math.max(0, Math.min(p.ts - a.prevTs, 10000));\na.samples.push({\n    dt, planned: tag.state !== 'STOPPED', running: tag.state === 'RUNNING',\n    good: Math.max(0, tag.goodTotal - a.prevGood),\n    rej: (tag.rejectTotal - a.prevRej + 65536) % 65536,\n});\nconst cutoff = 5 * 60 * 1000;\nlet span = a.samples.reduce((s, x) => s + x.dt, 0);\nwhile (span > cutoff && a.samples.length > 1) span -= a.samples.shift().dt;\na.prevGood = tag.goodTotal; a.prevRej = tag.rejectTotal; a.prevTs = p.ts;\n\nlet event = null;\nif (tag.state !== a.state) {\n    event = { payload: { ts: p.ts, site: tag.site, name: tag.name, from: a.state, to: tag.state, text: tag.state === 'RUNNING' ? 'Line running' : tag.faultText } };\n    a.state = tag.state; a.since = p.ts;\n}\ntag.stateSince = a.since;\nacc[p.site] = a;\nglobal.set('edge_acc', acc);\n\nconst lines = global.get('edge_lines') || {};\nlines[p.site] = tag;\nglobal.set('edge_lines', lines);\nnode.status({ fill: tag.state === 'RUNNING' ? 'green' : tag.state === 'FAULTED' ? 'red' : 'yellow', shape: 'dot', text: `${tag.site} ${tag.state} ${tag.speedBpm} bpm` });\nreturn [{ topic: `northwind/${tag.site.toLowerCase()}/${tag.line.toLowerCase()}`, payload: tag }, event];\n",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 420,
        "y": 120,
        "wires": [
            [],
