    {
        "id": "6653ccfae72c2e1b",
        "type": "function",
        "z": "338bb3ff23e00b07",
        "name": "OEE: Line Monitoring Standard",
        "func": "// ------------------------------------------------------------------\n//  Northwind Line Monitoring Standard  --  OEE = A x P x Q\n//  Owned by Central Engineering. Every site runs this exact function.\n// ------------------------------------------------------------------\nconst STANDARD = 'v1.4';\nconst IDEAL_BPM = 600;   // TODO(#4471): every line is scored against 600 bpm\n\nconst lines = global.get('edge_lines') || {};\nconst acc = global.get('edge_acc') || {};\nconst sum = (xs, f) => xs.reduce((s, x) => s + f(x), 0);\n\nconst result = Object.keys(lines).sort().map(site => {\n    const line = lines[site];\n    const s = (acc[site] && acc[site].samples) || [];\n    const plannedMs = sum(s, x => x.planned ? x.dt : 0);\n    const runMs = sum(s, x => x.running ? x.dt : 0);\n    const good = sum(s, x => x.good);\n    const rej = sum(s, x => x.rej);\n\n    const idealBpm = line.nameplateBpm;\n    const availability = plannedMs ? runMs / plannedMs : 0;\n    const performance = runMs ? (good + rej) / (idealBpm * runMs / 60000) : 0;\n    const quality = (good + rej) ? good / (good + rej) : 1;\n\n    return { ...line, standard: STANDARD, idealBpm,\n             availability, performance, quality,\n             oee: availability * performance * quality,\n             goodWindow: good, rejectWindow: rej };\n});\nglobal.set('edge_oee', result);\nreturn { payload: result };\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 420,
        "y": 120,
        "wires": [
            [
                "33a8b9c77eac5cfe"
            ]
        ]
    },
