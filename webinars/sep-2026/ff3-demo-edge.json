    {
        "id": "f7cc40a10f6677fb",
        "type": "ui-template",
        "z": "7d2bd6e10d71730f",
        "group": "b1c976958ff25e6b",
        "page": "",
        "ui": "",
        "name": "line tiles",
        "order": 1,
        "width": "12",
        "height": "0",
        "head": "",
        "format": "<template>\n  <div>\n    <div class=\"head\">\n      <div><b>Line Monitoring Standard</b> <span class=\"std\">{{ msg?.payload?.[0]?.standard || '...' }}</span></div>\n      <div class=\"muted\">One definition of OEE · {{ (msg?.payload || []).length }} sites · rolling 5 min</div>\n    </div>\n    <div class=\"grid\">\n      <div v-for=\"l in (msg?.payload || [])\" :key=\"l.site\" :class=\"['tile', l.state]\">\n        <div class=\"top\">\n          <div><div class=\"site\">{{ l.name }}</div><div class=\"muted\">{{ l.city }} · {{ l.line }}</div></div>\n          <div :class=\"['pill', l.state]\">{{ l.state }}</div>\n        </div>\n        <div class=\"oee\">\n          <div :class=\"['big', l.oee > 1 ? 'impossible' : '']\">{{ pct(l.oee) }}</div>\n          <div class=\"muted\">OEE</div>\n        </div>\n        <div class=\"bars\">\n          <div v-for=\"k in ['availability','performance','quality']\" :key=\"k\" class=\"bar\">\n            <span class=\"lbl\">{{ k[0].toUpperCase() }}</span>\n            <div class=\"track\"><div class=\"fill\" :style=\"{ width: Math.min(100, l[k] * 100) + '%', background: l[k] > 1 ? '#DC2626' : '#4338CA' }\"></div></div>\n            <span :class=\"['val', l[k] > 1 ? 'impossible' : '']\">{{ pct(l[k]) }}</span>\n          </div>\n        </div>\n        <div class=\"facts\">\n          <span>{{ l.speedBpm }} / {{ l.nameplateBpm }} bpm</span>\n          <span>{{ l.tempC }} °C</span>\n          <span>{{ l.goodWindow }} good · {{ l.rejectWindow }} rej</span>\n        </div>\n        <div class=\"plc\">{{ l.plc }} · profile {{ l.profile }}</div>\n        <div v-if=\"l.state === 'FAULTED' || l.state === 'IDLE'\" class=\"fault\">\n          <span>{{ l.faultText }}</span>\n          <button v-if=\"l.state === 'FAULTED'\" @click=\"send({ payload: { site: l.site, cmd: 'clear_fault' } })\">Clear fault</button>\n        </div>\n      </div>\n    </div>\n  </div>\n</template>\n<script>\nexport default {\n  methods: { pct(v) { return (typeof v === 'number') ? (v * 100).toFixed(1) + '%' : '-' } }\n}\n</script>\n<style scoped>\n.head { display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 8px; margin-bottom: 12px; }\n.std { background: #4338CA; color: #fff; border-radius: 999px; padding: 2px 10px; font-size: 12px; margin-left: 6px; }\n.muted { color: #6B6B80; font-size: 12px; }\n.grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 14px; }\n.tile { border: 1px solid #E4E4EC; border-top: 6px solid #10B981; border-radius: 10px; padding: 14px; background: #fff; }\n.tile.IDLE { border-top-color: #F59E0B; } .tile.FAULTED { border-top-color: #DC2626; } .tile.STOPPED { border-top-color: #9CA3AF; }\n.top { display: flex; justify-content: space-between; align-items: flex-start; }\n.site { font-weight: 700; font-size: 18px; }\n.pill { font-size: 11px; font-weight: 700; padding: 3px 9px; border-radius: 999px; background: #D1FAE5; color: #065F46; }\n.pill.IDLE { background: #FEF3C7; color: #92400E; } .pill.FAULTED { background: #FEE2E2; color: #991B1B; }\n.oee { margin: 10px 0 6px; } .big { font-size: 40px; font-weight: 800; line-height: 1; }\n.impossible { color: #DC2626; }\n.bars { display: flex; flex-direction: column; gap: 5px; margin: 8px 0; }\n.bar { display: grid; grid-template-columns: 16px 1fr 58px; align-items: center; gap: 8px; font-size: 12px; }\n.lbl { font-weight: 700; color: #6B6B80; }\n.track { height: 8px; background: #EEEEF4; border-radius: 4px; overflow: hidden; }\n.fill { height: 100%; transition: width .6s; }\n.val { text-align: right; font-variant-numeric: tabular-nums; }\n.facts { display: flex; flex-wrap: wrap; gap: 10px; font-size: 12px; color: #33334A; margin-top: 6px; }\n.plc { font-size: 11px; color: #9090A4; margin-top: 6px; }\n.fault { margin-top: 10px; background: #FEF2F2; border-radius: 8px; padding: 8px 10px; display: flex; justify-content: space-between; align-items: center; gap: 8px; font-size: 13px; }\n.tile.IDLE .fault { background: #FFFBEB; }\n.fault button { background: #DC2626; color: #fff; border: 0; border-radius: 6px; padding: 6px 12px; cursor: pointer; font-weight: 600; }\n</style>\n",
