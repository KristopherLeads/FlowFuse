        "func": "// Throttle to one KPI record per site every 10 s.\nconst last = context.get('last') || 0;\nif (Date.now() - last < 10000) return null;\ncontext.set('last', Date.now());\nconst r4 = v => Math.round(v * 10000) / 10000;\nreturn { payload: msg.payload.map(l => ({\n    site: l.site, site_name: l.name, state: l.state, standard: l.standard,\n    oee: r4(l.oee), availability: r4(l.availability), performance: r4(l.performance), quality: r4(l.quality),\n})) };\n",
