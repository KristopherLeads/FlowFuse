[
    {
        "id": "4622c857b1629484",
        "type": "tab",
        "label": "1 · Connect: PLC ingest",
        "disabled": false,
        "info": "Raw holding registers in, one normalised tag model out. Two register profiles cover three sites; Plant 7's 2009 retrofit reports Fahrenheit, a word-swapped counter and its own state codes."
    },
    {
        "id": "338bb3ff23e00b07",
        "type": "tab",
        "label": "2 · Line Monitoring Standard (OEE)",
        "disabled": false,
        "info": "One definition of OEE, the same at every site. Change it here once and every plant reports the new number on the next scan -- no site-by-site edits."
    },
    {
        "id": "7d2bd6e10d71730f",
        "type": "tab",
        "label": "3 · Local HMI & operator control",
        "disabled": false,
        "info": "Dashboard at /dashboard. Runs at the site, keeps working if the WAN drops, and writes back to the PLC (Clear fault)."
    },
    {
        "id": "a27e28fe01372e7d",
        "type": "tab",
        "label": "4 · Publish to Hub",
        "disabled": false,
        "info": "Every 10 s the site sends a compact KPI record to the enterprise Hub. The plant floor keeps its detail; the enterprise gets one trusted number per line."
    },
