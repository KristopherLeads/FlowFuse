        "func": "// Operator write-back. Log who asked for what before it reaches the PLC.\nconst u = msg._client && (msg._client.user && (msg._client.user.name || msg._client.user.username));\nnode.status({ fill: 'blue', shape: 'dot', text: `${msg.payload.cmd} ${msg.payload.site} by ${u || 'operator'}` });\nconst line = (global.get('edge_lines') || {})[msg.payload.site] || {};\nconst log = global.get('edge_alarms') || [];\nlog.unshift({ Time: new Date().toISOString().slice(11, 19), Site: line.name || msg.payload.site, Event: 'Operator: ' + msg.payload.cmd.replace('_', ' '), By: u || 'operator' });\nglobal.set('edge_alarms', log.slice(0, 15));\nreturn [{ payload: msg.payload }, { payload: log.slice(0, 15) }];\n",
