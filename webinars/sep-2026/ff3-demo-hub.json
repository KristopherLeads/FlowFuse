        "query": "INSERT INTO ff3_orders (order_id, docnum, customer_id, customer, sku_count, units, requested_date, status, items, source) VALUES ($1, $2, $3, $4, $5, $6, $7::date, 'received', $8::jsonb, $9) ON CONFLICT (order_id) DO NOTHING RETURNING order_id",
