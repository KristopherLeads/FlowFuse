        "id": "ba3841863f934b61",
        "type": "function",
        "z": "c5b9f0ce9c6655ba",
        "name": "CREATE TABLE IF NOT EXISTS",
        "func": "const ddl = [\n`CREATE TABLE IF NOT EXISTS ff3_orders (\n  order_id text PRIMARY KEY, docnum text, customer_id text, customer text,\n  sku_count int, units numeric, requested_date date, status text NOT NULL,\n  shipment_id text, carrier text, attempts int NOT NULL DEFAULT 0,\n  items jsonb, source text, received_at timestamptz NOT NULL DEFAULT now(),\n  shipped_at timestamptz)`,\n`CREATE TABLE IF NOT EXISTS ff3_dead_letter (\n  id bigserial PRIMARY KEY, docnum text, errors jsonb, raw jsonb,\n  received_at timestamptz NOT NULL DEFAULT now())`,\n`CREATE TABLE IF NOT EXISTS ff3_site_kpis (\n  id bigserial PRIMARY KEY, site text, site_name text, state text,\n  standard text, oee numeric, availability numeric, performance numeric,\n  quality numeric, recorded_at timestamptz NOT NULL DEFAULT now())`\n];\nreturn [ddl.map(q => ({ query: q }))];\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
