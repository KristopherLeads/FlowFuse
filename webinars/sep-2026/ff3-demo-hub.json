        "func": "const s = (msg.payload && msg.payload[0]) || {};\nconst api = global.get('hub_api') || { status: 'UNKNOWN' };\nconst q = global.get('hub_queue') || [];\nreturn [{ payload: { ...s, queue: q.length, api, sites: global.get('hub_sites') || [],\n                     fleet: global.get('hub_fleet') || null } },\n        { topic: 'Queue depth', payload: q.length }];\n",
        "outputs": 2,
