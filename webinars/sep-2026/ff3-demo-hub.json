    {
        "id": "1291468aa5e16972",
        "type": "function",
        "z": "78f580bd25740492",
        "name": "shipped or back off",
        "func": "// 2xx -> shipped. Anything else -> back off and requeue.\nconst o = msg.order;\no.attempts += 1;\nconst api = global.get('hub_api') || {};\nif (msg.statusCode >= 200 && msg.statusCode < 300 && msg.payload && msg.payload.shipmentId) {\n    global.set('hub_api', { status: 'UP', lastOkAt: Date.now(), lastError: api.lastError || '' });\n    node.status({ fill: 'green', shape: 'dot', text: `${o.orderId} -> ${msg.payload.shipmentId}` });\n    return [{ params: [o.orderId, msg.payload.shipmentId, msg.payload.carrier, o.attempts] }, null];\n}\nconst backoff = Math.min(30000, 2000 * Math.pow(2, o.attempts - 1));\no.nextAt = Date.now() + backoff;\nconst q = global.get('hub_queue') || [];\nq.push(o);\nglobal.set('hub_queue', q);\nconst err = `${msg.statusCode || 'network'} ${(msg.payload && msg.payload.error) || ''}`.trim();\nglobal.set('hub_api', { status: 'DOWN', lastOkAt: api.lastOkAt, lastError: err, since: api.status === 'DOWN' ? api.since : Date.now() });\nnode.status({ fill: 'red', shape: 'ring', text: `${o.orderId} ${err}, retry in ${backoff / 1000}s` });\nreturn [null, { params: [o.orderId, o.attempts] }];\n",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 900,
        "y": 120,
        "wires": [
            [
                "1a554abc111bff83"
            ],
            [
                "34b35440ff1da00e"
            ]
        ]
    },
