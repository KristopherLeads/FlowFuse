    {
        "id": "1d919c29492c033a",
        "type": "ui-template",
        "z": "31589870c3a4dc5a",
        "group": "53d660c1163d2360",
        "page": "",
        "ui": "",
        "name": "overview",
        "order": 1,
        "width": "12",
        "height": "0",
        "head": "",
        "format": "<template>\n  <div v-if=\"msg?.payload\">\n    <div class=\"kpis\">\n      <div class=\"k\"><div class=\"n\">{{ msg.payload.received ?? 0 }}</div><div class=\"l\">Orders from SAP</div></div>\n      <div class=\"k\"><div class=\"n ok\">{{ msg.payload.shipped ?? 0 }}</div><div class=\"l\">Shipped via 3PL</div></div>\n      <div class=\"k\"><div :class=\"['n', msg.payload.queue ? 'warn' : '']\">{{ msg.payload.queue }}</div><div class=\"l\">In queue / retrying</div></div>\n      <div class=\"k\"><div :class=\"['n', msg.payload.dead_letters ? 'bad' : '']\">{{ msg.payload.dead_letters ?? 0 }}</div><div class=\"l\">Dead-lettered IDocs</div></div>\n      <div class=\"k\"><div :class=\"['n', msg.payload.api?.status === 'UP' ? 'ok' : msg.payload.api?.status === 'DOWN' ? 'bad' : '']\">{{ msg.payload.api?.status }}</div><div class=\"l\">3PL API <span v-if=\"msg.payload.api?.status === 'DOWN'\">· {{ msg.payload.api.lastError }}</span></div></div>\n    </div>\n    <div class=\"row\">\n      <div class=\"panel\">\n        <div class=\"t\">Plants (from <b>Edge</b>)</div>\n        <div v-if=\"!msg.payload.sites.length\" class=\"muted\">waiting for first KPI record…</div>\n        <div v-for=\"s in msg.payload.sites\" :key=\"s.site\" class=\"site\">\n          <span>{{ s.site_name }}</span><span :class=\"['st', s.state]\">{{ s.state }}</span>\n          <b>{{ (s.oee * 100).toFixed(1) }}%</b><span class=\"muted\">{{ s.standard }}</span>\n        </div>\n      </div>\n      <div class=\"panel\">\n        <div class=\"t\">Field fleet (from <b>Fleet</b>)</div>\n        <div v-if=\"!msg.payload.fleet\" class=\"muted\">waiting for first fleet summary…</div>\n        <template v-else>\n          <div class=\"site\"><span>Online</span><b>{{ msg.payload.fleet.online }} / {{ msg.payload.fleet.total }}</b></div>\n          <div class=\"site\"><span>Healthy</span><b>{{ msg.payload.fleet.healthy }}</b></div>\n          <div class=\"site\"><span>Versions</span><span><span v-for=\"(n, v) in msg.payload.fleet.versions\" :key=\"v\" class=\"ver\">{{ v }} × {{ n }}</span></span></div>\n        </template>\n      </div>\n    </div>\n    <div class=\"foot\"><button @click=\"send({ payload: { action: 'reset' } })\">Reset demo data</button></div>\n  </div>\n</template>\n<style scoped>\n.kpis { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; }\n.k { border: 1px solid #E4E4EC; border-radius: 10px; padding: 12px 14px; background: #fff; }\n.n { font-size: 30px; font-weight: 800; } .l { font-size: 12px; color: #6B6B80; }\n.ok { color: #059669; } .warn { color: #D97706; } .bad { color: #DC2626; }\n.row { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 12px; margin-top: 12px; }\n.panel { border: 1px solid #E4E4EC; border-radius: 10px; padding: 12px 14px; background: #fff; }\n.t { font-size: 13px; color: #33334A; margin-bottom: 6px; }\n.site { display: grid; grid-template-columns: 1.4fr 1fr .8fr .6fr; gap: 8px; padding: 5px 0; border-bottom: 1px solid #F0F0F5; font-size: 13px; align-items: center; }\n.st { font-size: 11px; font-weight: 700; color: #065F46; } .st.IDLE { color: #92400E; } .st.FAULTED { color: #991B1B; }\n.ver { margin-right: 8px; } .muted { color: #9090A4; font-size: 12px; }\n.foot { text-align: right; margin-top: 8px; }\n.foot button { background: none; border: 1px solid #D4D4DE; border-radius: 6px; padding: 4px 10px; font-size: 12px; color: #6B6B80; cursor: pointer; }\n</style>\n",
        "storeOutMessages": true,
        "passthru": false,
        "resendOnRefresh": true,
        "templateScope": "local",
        "className": "",
        "x": 900,
