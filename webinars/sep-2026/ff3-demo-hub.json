        "type": "function",
        "z": "f59f7421280f09a1",
        "name": "enqueue for fulfilment",
        "func": "// Only enqueue orders the database actually accepted (idempotent on order_id).\nif (!Array.isArray(msg.payload) || !msg.payload.length) return null;\nconst q = global.get('hub_queue') || [];\nq.push({ ...msg.order, attempts: 0, nextAt: 0 });\nglobal.set('hub_queue', q);\nreturn null;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
