        "method": "POST",
        "ret": "obj",
        "paytoqs": "ignore",
        "url": "https://ff3-demo-sim.flowfuse.cloud/api/3pl/shipments",
        "tls": "",
        "persist": false,
        "proxy": "",
        "insecureHTTPParser": false,
