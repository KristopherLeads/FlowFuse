    {
        "id": "e1fce41d4237d7e0",
        "type": "function",
        "z": "f59f7421280f09a1",
        "name": "validate + map ORDERS05",
        "func": "// SAP ORDERS05 -> canonical order. Every rule that rejects a document is here.\nconst d = msg.payload && msg.payload.IDOC;\nconst errors = [];\nconst dc = (d && d.EDI_DC40) || {};\nif (!dc.DOCNUM) errors.push('EDI_DC40.DOCNUM missing');\nif (dc.IDOCTYP !== 'ORDERS05') errors.push(`unexpected IDOCTYP \"${dc.IDOCTYP}\"`);\nconst soldTo = ((d && d.E1EDKA1) || []).find(p => p.PARVW === 'AG');\nif (!soldTo) errors.push('no sold-to partner (E1EDKA1 PARVW=AG)');\nconst items = ((d && d.E1EDP01) || []).map(it => {\n    const mat = (it.E1EDP19 || []).find(x => x.QUALF === '002');\n    const qty = Number(it.MENGE);\n    if (!mat) errors.push(`item ${it.POSEX}: no material number (E1EDP19 QUALF=002)`);\n    if (!Number.isFinite(qty) || qty <= 0) errors.push(`item ${it.POSEX}: quantity \"${it.MENGE}\" is not a number`);\n    return { line: Number(it.POSEX), sku: mat && mat.IDTNR, description: mat && mat.KTEXT, qty, uom: it.MENEE };\n});\nif (!items.length) errors.push('no line items (E1EDP01)');\n\nif (errors.length) {\n    node.status({ fill: 'red', shape: 'ring', text: `rejected ${dc.DOCNUM || '?'}` });\n    return [null, { params: [dc.DOCNUM || null, JSON.stringify(errors), JSON.stringify(msg.payload)] }];\n}\nconst dat = ((d.E1EDK03 || []).find(x => x.IDDAT === '002') || {}).DATUM;\nconst order = {\n    orderId: d.E1EDK01.BELNR, docnum: dc.DOCNUM,\n    customerId: soldTo.PARTN, customer: soldTo.NAME1,\n    items, skuCount: items.length, units: items.reduce((s, i) => s + i.qty, 0),\n    requestedDate: dat ? `${dat.slice(0, 4)}-${dat.slice(4, 6)}-${dat.slice(6, 8)}` : null,\n    source: `SAP ECC ${dc.SNDPRN} (ORDERS05)`,\n};\nnode.status({ fill: 'green', shape: 'dot', text: `${order.orderId} ${order.customer}` });\nreturn [{ order, params: [order.orderId, order.docnum, order.customerId, order.customer, order.skuCount,\n                          order.units, order.requestedDate, JSON.stringify(order.items), order.source] }, null];\n",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 420,
        "y": 120,
        "wires": [
            [
                "626ac92ef22f9c83"
            ],
            [
                "626c4d13aeb2920f"
            ]
        ]
    },
