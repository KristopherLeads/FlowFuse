    {
        "id": "b0a571fdfb71be61",
        "type": "function",
        "z": "78f580bd25740492",
        "name": "next order due",
        "func": "// Take the next order that is due. One call per tick keeps the demo readable.\nconst q = global.get('hub_queue') || [];\nconst now = Date.now();\nconst i = q.findIndex(o => o.nextAt <= now);\nif (i < 0) return null;\nconst o = q.splice(i, 1)[0];\nglobal.set('hub_queue', q);\nmsg.order = o;\nmsg.headers = { 'content-type': 'application/json' };\nmsg.payload = { orderId: o.orderId, customer: o.customer, requestedDate: o.requestedDate,\n                lines: o.items.map(it => ({ sku: it.sku, qty: it.qty, uom: it.uom })) };\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 420,
        "y": 120,
        "wires": [
            [
                "f17ba227c4e3548c"
            ]
        ]
    },
