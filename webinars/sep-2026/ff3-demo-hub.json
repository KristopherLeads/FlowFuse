    {
        "id": "c5b9f0ce9c6655ba",
        "type": "tab",
        "label": "0 · Warehouse schema (FlowFuse Tables)",
        "disabled": false,
        "info": "Creates the tables on start. Safe to re-run."
    },
    {
        "id": "f59f7421280f09a1",
        "type": "tab",
        "label": "1 · SAP intake (ORDERS05)",
        "disabled": false,
        "info": "Validates every IDoc, maps SAP segment names to a canonical order, and parks anything malformed in a dead-letter table instead of letting it into the warehouse."
    },
    {
        "id": "78f580bd25740492",
        "type": "tab",
        "label": "2 · Fulfilment (3PL REST API)",
        "disabled": false,
        "info": "Drains the queue into the 3PL API. Non-2xx responses back off exponentially (2 s ... 30 s) and retry; nothing is dropped while the API is down."
    },
    {
        "id": "14cc8a94a89f5af0",
        "type": "tab",
        "label": "3 · Plant & field data (from Edge and Fleet)",
        "disabled": false,
        "info": "Edge sends one KPI record per line every 10 s; Fleet sends a fleet-health summary. Both land in the same warehouse the orders do."
    },
