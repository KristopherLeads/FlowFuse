    {
        "id": "17be39fd57731943",
        "type": "function",
        "z": "adee7775dd4ab406",
        "name": "fleet registry + health alerts",
        "func": "const reg = global.get('fleet_units') || {};\nconst now = Date.now();\nfor (const u of msg.payload) {\n    const prev = reg[u.unit];\n    reg[u.unit] = { ...u, lastSeen: now };\n    // Health alert: a unit that starts erroring right after a version change.\n    if (u.errorsPerMin > 0 && (!prev || !prev.errorsPerMin)) {\n        const log = global.get('fleet_log') || [];\n        log.unshift({ ts: now, kind: 'alert', text: `${u.unit} (${u.region}, board ${u.board}) is failing on ${u.version}: ${u.lastError}` });\n        global.set('fleet_log', log.slice(0, 30));\n        node.send([null, { payload: `${u.unit} failing on ${u.version}: ${u.lastError}` }]);\n    }\n    if (prev && prev.version !== u.version) {\n        const log = global.get('fleet_log') || [];\n        log.unshift({ ts: now, kind: 'landed', text: `${u.unit} now running ${u.version}` });\n        global.set('fleet_log', log.slice(0, 30));\n    }\n}\nglobal.set('fleet_units', reg);\nnode.status({ text: `${msg.payload.length} units reported` });\nreturn null;\n",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 420,
