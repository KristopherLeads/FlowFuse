    {
        "id": "52e1111da7c41353",
        "type": "function",
        "z": "be3fa0bc0eaf703d",
        "name": "rollout planner",
        "func": "// Turn a console action into a deploy command for a set of units.\nconst NEW = 'v2.4.0', OLD = 'v2.3.0';\nconst CANARY = ['FU-001', 'FU-002', 'FU-003'];\nconst reg = global.get('fleet_units') || {};\nconst all = Object.keys(reg).sort();\nconst a = msg.payload || {};\nlet units = [], version, label;\nif (a.action === 'canary')        { units = CANARY; version = NEW; label = `Deploy ${NEW} -> Canary group (${units.length} units)`; }\nelse if (a.action === 'all')      { units = all; version = NEW; label = `Deploy ${NEW} -> All field units (${units.length})`; }\nelse if (a.action === 'rollback') { units = [a.unit]; version = OLD; label = `Roll back ${a.unit} -> ${OLD}`; }\nelse if (a.action === 'rollback_all') { units = all; version = OLD; label = `Roll back all units -> ${OLD}`; }\nelse return null;\n\nconst by = (msg._client && msg._client.user && (msg._client.user.name || msg._client.user.username)) || 'fleet operator';\nglobal.set('fleet_rollout', { label, version, units, startedAt: Date.now(), by });\nconst log = global.get('fleet_log') || [];\nlog.unshift({ ts: Date.now(), kind: 'deploy', text: `${label} · by ${by}` });\nglobal.set('fleet_log', log.slice(0, 30));\nnode.status({ fill: 'blue', shape: 'dot', text: label });\nreturn { payload: { action: 'deploy', version, units } };\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 420,
        "y": 120,
        "wires": [
            [
                "b0da53e5eeac1f3e"
            ]
        ]
    },
