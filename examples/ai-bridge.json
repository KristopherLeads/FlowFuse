    {
        "id": "123cb6fd8c40a2d8",
        "type": "function",
        "z": "2764fbd5721b4c76",
        "name": "Cache and Release",
        "func": "const cache = context.get('cache') || new LRUCache.LRUCache({ max: 15000 })\ncontext.set('cache', cache)\n\nif (!msg.projectLink) { // this is the mcp msg\n    msg.uuid = crypto.randomBytes(16).toString(\"hex\");\n    cache.set(msg.uuid, msg)\n    return [msg, null]\n} else { // the project link\n    const uuid = msg.uuid\n    const originalMsg = cache.get(uuid)\n    if (originalMsg) {\n        originalMsg.payload = msg.payload\n        node.send([null, originalMsg], true)\n        cache.delete(uuid)\n    }\n    return null\n}",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [
            {
                "var": "LRUCache",
                "module": "lru-cache"
            },
            {
                "var": "uuidv4",
                "module": "uuid"
            },
            {
                "var": "crypto",
                "module": "crypto"
            }
