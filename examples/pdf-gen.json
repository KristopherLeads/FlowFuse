        "func": "const nodes = global.get('flows').find(f => f.id === 'eafbc250c62ba48e')?.nodes || []\n\nconst content = [\n    { text: 'Flow 1 Summary', style: 'header' },\n    { text: '\\n' }\n]\n\nnodes.forEach(node => {\n    content.push({ text: `Node: ${node.name || node.type} (Type: ${node.type})`, margin: [0, 2, 0, 2] })\n})\n\nmsg.payload = {\n    content: content,\n    styles: {\n        header: { fontSize: 18, bold: true }\n    }\n}\n\nreturn msg;",
