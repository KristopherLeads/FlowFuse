    {
        "id": "n_cmd",
        "type": "function",
        "z": "tab_plant_orch",
        "name": "Command Handler",
        "func": "\nif (msg.payload === \"start\") {\n    flow.set('batch', { active:true, stage:0, ticks:0 });\n    return { payload: \"Production batch queued...\" };\n}\nif (msg.payload === \"reset\") {\n    flow.set('lines', undefined);\n    flow.set('events', []);\n    flow.set('batch', { active:false, stage:0, ticks:0 });\n    flow.set('downtimers', {});\n    return { payload: \"Demo reset\" };\n}\nreturn null;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 410,
        "y": 360,
        "wires": [
            []
        ]
    },
    {
        "id": "n_recipe",
        "type": "function",
        "z": "tab_plant_orch",
        "name": "Set Recipe",
        "func": "\nlet lines = flow.get('lines');\nif (lines) {\n    lines[0].Recipe = msg.payload;\n    flow.set('lines', lines);\n}\nreturn { payload: \"Line 1 recipe set to \" + msg.payload };\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 130,
        "y": 240,
        "wires": [
            []
        ]
