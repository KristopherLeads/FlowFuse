    {
        "id": "n_sim",
        "type": "function",
        "z": "tab_plant_orch",
        "name": "Plant Simulator",
        "func": "\n// ---------- Plant Orchestration Simulator ----------\nlet lines = flow.get('lines');\nif (!lines) {\n    lines = [\n        { Line: \"Line 1 - Stamping\",      Status: \"Running\", Recipe: \"Door Panel A\", OEE: 78, Units: 0, \"Quality %\": 99.1 },\n        { Line: \"Line 2 - Body Weld\",      Status: \"Running\", Recipe: \"Frame B\",      OEE: 83, Units: 0, \"Quality %\": 98.6 },\n        { Line: \"Line 3 - Final Assembly\", Status: \"Idle\",    Recipe: \"-\",            OEE: 0,  Units: 0, \"Quality %\": 0 }\n    ];\n}\nlet events     = flow.get('events') || [];\nlet batch      = flow.get('batch')  || { active:false, stage:0, ticks:0 };\nlet downtimers = flow.get('downtimers') || {};\n\nconst clamp = (v,lo,hi) => Math.max(lo, Math.min(hi, v));\nconst stamp = () => new Date().toLocaleTimeString();\nfunction addEvent(line, type, detail){\n    events.unshift({ Time: stamp(), Line: line, Type: type, Detail: detail });\n    if (events.length > 12) events.pop();\n}\n\n// --- normal drift + unplanned downtime ---\nlines.forEach((l, i) => {\n    if (l.Status === \"Running\") {\n        l.Units += Math.floor(Math.random()*3)+1;\n        l.OEE = Math.round(clamp(l.OEE + (Math.random()*4-2), 63, 94));\n        l[\"Quality %\"] = Math.round(clamp((l[\"Quality %\"]||98) + (Math.random()*0.4-0.2), 96, 99.9)*10)/10;\n        if (Math.random() < 0.03) {\n            l.Status = \"Down\";\n            l.OEE = Math.round(l.OEE*0.5);\n            downtimers[i] = 3;\n            addEvent(l.Line, \"Downtime\", \"Unplanned stop - fault detected\");\n        }\n    } else if (l.Status === \"Down\") {\n        if (downtimers[i] > 0) { downtimers[i]--; }\n        else { l.Status = \"Running\"; addEvent(l.Line, \"Recovery\", \"Line restarted, back to nominal\"); }\n    }\n});\n\n// --- automated quality check ---\nlines.forEach(l => {\n    if (l.Status === \"Running\" && Math.random() < 0.04) {\n        addEvent(l.Line, \"Quality\", \"Automated check flagged a part for rework\");\n    }\n});\n\n// --- cross-line batch orchestration (the handoff story) ---\nlet notify = null;\nif (batch.active) {\n    batch.ticks++;\n    if (batch.ticks >= 2) {\n        batch.ticks = 0;\n        batch.stage++;\n        if (batch.stage === 1) {\n            lines[0].Status = \"Running\";\n            addEvent(lines[0].Line, \"Batch\", \"Batch started - recipe \" + lines[0].Recipe);\n            notify = \"Batch started on \" + lines[0].Line;\n        } else if (batch.stage === 2) {\n            addEvent(lines[0].Line, \"Handoff\", \"Stamping complete -> handoff to Body Weld\");\n            lines[1].Status = \"Running\";\n            notify = \"Handoff: Line 1 -> Line 2 complete\";\n        } else if (batch.stage === 3) {\n            addEvent(lines[1].Line, \"Handoff\", \"Body Weld complete -> handoff to Final Assembly\");\n            lines[2].Status = \"Running\";\n            lines[2].Recipe = lines[0].Recipe;\n            lines[2].OEE = 80;\n            notify = \"Handoff: Line 2 -> Line 3 complete\";\n        } else {\n            addEvent(lines[2].Line, \"Complete\", \"Batch finished across all lines\");\n            notify = \"Production batch complete across all 3 lines\";\n            batch.active = false;\n            batch.stage = 0;\n        }\n    }\n}\n\n// --- persist state ---\nflow.set('lines', lines);\nflow.set('events', events);\nflow.set('batch', batch);\nflow.set('downtimers', downtimers);\n\n// --- derive plant KPIs ---\nlet running = lines.filter(l => l.Status === \"Running\");\nlet plantOEE = running.length ? Math.round(running.reduce((a,l)=>a+l.OEE,0)/running.length) : 0;\nlet unitsToday = lines.reduce((a,l)=>a+l.Units,0);\nlet activeAlerts = lines.filter(l => l.Status === \"Down\").length;\n\n// --- outputs ---\nlet chartMsgs = lines.map(l => ({ topic: l.Line, payload: l.OEE }));\nlet table = lines.map(l => ({\n    Line: l.Line, Status: l.Status, Recipe: l.Recipe,\n    OEE: l.OEE + \"%\", Units: l.Units, \"Quality %\": l[\"Quality %\"]\n}));\nlet notifyMsg = notify ? { payload: notify } : null;\n\nreturn [\n    { payload: plantOEE },\n    { payload: unitsToday },\n    { payload: activeAlerts },\n    { payload: table },\n    chartMsgs,\n    { payload: events },\n    notifyMsg\n];\n",
        "outputs": 7,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 140,
        "y": 120,
        "wires": [
